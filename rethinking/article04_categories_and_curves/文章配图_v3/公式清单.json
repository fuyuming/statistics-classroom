      "H\\mid S=2\\sim\\mathrm{Normal}(160,5)",
      "W\\mid H,S\\sim\\mathrm{Normal}(a_S+b_SH,5)"
    ]
  },
  {
    "file": "公式-09-样条模型.png",
    "title": "用年龄预测身高：局部形状乘权重再相加",
    "latex": [
      "H_i\\mid\\alpha_0,w,\\sigma,A_i\\sim\\mathrm{Normal}(\\mu_i,\\sigma)",
      "\\mu_i=\\alpha_0+\\sum_{k=1}^{K}w_kB_k(A_i)"
    ]
  },
  {
    "file": "公式-10-样条先验.png",
    "title": "年龄—身高模型：课程配套脚本的设定",
    "latex": [
      "\\alpha_0\\sim\\mathrm{Normal}(120,1)",
      "w_k\\sim\\mathrm{Normal}(0,25),\\quad k=1,\\ldots,23",
      "\\log\\sigma\\sim\\mathrm{Normal}(0,0.5)"
    ]
  },
  {
    "file": "公式-11-已知总效应.png",
