      "\\sigma\\sim\\mathrm{Uniform}(0,10)"
    ]
  },
  {
    "file": "公式-07-同身高对比.png",
    "title": "与 PPT 第61页一致：女性减男性",
    "latex": [
      "\\Delta(h)=\\mu_1(h)-\\mu_2(h)",
      "=(\\alpha_1-\\alpha_2)+(\\beta_1-\\beta_2)(h-\\bar H)"
    ]
  },
  {
    "file": "公式-08-模拟生成规则.png",
    "title": "PPT 第21—23页：先生成身高，再生成体重",
    "latex": [
