    "\\quad+(5-4)^2+(6-4)^2=10",
    "\\text{loss for }t\\text{ ties}=\\frac{t^3-t}{12}"
  ],
  "7": [
    "\\mathrm{SS}_{\\mathrm{base}}=\\frac{24(24^2-1)}{12}=1150",
    "\\mathrm{loss}=0+10+10+5+60=85",
