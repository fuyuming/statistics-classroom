    "\\operatorname{Cov}_0(Y_a,Y_b)=-\\dfrac{s_r^2}{N}",
    "\\qquad (a\\ne b)"
  ],
  "3b": [
    "\\operatorname{Var}_0(\\bar Y_i)=\\dfrac{1}{n_i^2}\\left[n_i\\dfrac{N-1}{N}s_r^2\\right.",
    "\\qquad\\left.-n_i(n_i-1)\\dfrac{s_r^2}{N}\\right]",
    "\\quad=s_r^2\\left(\\dfrac{1}{n_i}-\\dfrac{1}{N}\\right)",
    "\\operatorname{Cov}_0(\\bar Y_i,\\bar Y_\\ell)=-\\dfrac{s_r^2}{N}",
    "\\qquad (i\\ne\\ell)"
  ],
  "3c": [
    "\\operatorname{E}_0(B)=\\sum_i n_i\\operatorname{Var}_0(\\bar Y_i)",
    "\\quad=s_r^2\\sum_i\\left(1-\\dfrac{n_i}{N}\\right)",
    "\\quad=(k-1)s_r^2",
    "H=\\dfrac{B}{s_r^2},\\qquad \\operatorname{E}_0(H)=k-1"
  ],
  "4": [
    "\\sum_{j=1}^{N}(j-\\bar r)^2=\\dfrac{N(N^2-1)}{12}",
    "s_{\\mathrm{base}}^2=\\dfrac{N(N+1)}{12}",
    "H^*=\\dfrac{B}{s_{\\mathrm{base}}^2}=\\dfrac{12B}{N(N+1)}"
  ],
  "5": [
    "R_i=n_i\\bar r_i,\\qquad \\sum_iR_i=N\\bar r",
    "B=\\sum_i\\dfrac{R_i^2}{n_i}-N\\bar r^2",
    "H^*=\\dfrac{12}{N(N+1)}\\sum_i\\dfrac{R_i^2}{n_i}",
    "\\qquad -3(N+1)"
  ],
  "6": [
    "2,3,4,5,6\\ \\longrightarrow\\ 4,4,4,4,4",
