    "s_r^2=\\frac{1065}{23}=46.3043478\\ldots",
    "C=\\frac{s_r^2}{50}=0.9260869565\\ldots"
  ],
  "7a": [
    "C=1-\\frac{\\sum_\\ell(t_\\ell^3-t_\\ell)}{N^3-N}",
    "s_r^2=\\frac{N(N+1)}{12}C"
  ],
  "8": [
    "H=\\frac{B}{s_r^2}=\\frac{H^*}{C}",
    "H=\\frac{546.583333\\ldots}{46.3043478\\ldots}",
