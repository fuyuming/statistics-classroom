{
  "1": [
    "\\bar r=\\dfrac{1+2+\\cdots+N}{N}=\\dfrac{N+1}{2}",
    "N=24,\\qquad \\bar r=12.5"
  ],
  "2": [
    "B=\\sum_{i=1}^{k}n_i(\\bar r_i-\\bar r)^2",
