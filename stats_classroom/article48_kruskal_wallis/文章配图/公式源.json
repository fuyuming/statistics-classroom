  "7": [
    "\\mathrm{SS}_{\\mathrm{base}}=\\dfrac{24(24^2-1)}{12}=1150",
    "\\mathrm{loss}=0+10+10+5+60",
    "\\quad=85",
    "\\mathrm{SS}_{\\mathrm{actual}}=1150-85=1065",
    "s_r^2=\\dfrac{1065}{23}=46.3043478\\ldots",
    "C=\\dfrac{s_r^2}{50}=0.9260869565\\ldots"
  ],
  "7a": [
    "C=1-\\dfrac{\\sum_\\ell(t_\\ell^3-t_\\ell)}{N^3-N}",
    "s_r^2=\\dfrac{N(N+1)}{12}C"
  ],
  "8": [
    "H=\\dfrac{B}{s_r^2}=\\dfrac{H^*}{C}",
